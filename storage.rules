service cloud.firestore {
  match /databases/{database}/documents {
    // UserMessages document rule with uniqueness constraint
    match /UserMessages/{chatId} {
      // Function to check if user is admin
      function isAdmin() {
        return request.auth.uid == 'Y4P4ECBLLWRbk7VZUqkpqqixE7H2';
      }

      // Function to check if user is part of the chat
      function isChatMember() {
        return request.auth.uid in resource.data.members;
      }

      // Allow create with uniqueness check
      allow create: if 
        request.auth != null &&
        // Ensure members array contains exactly 2 members
        request.resource.data.members.size() == 2 &&
        // Ensure current user or admin is creating
        (request.auth.uid in request.resource.data.members || isAdmin()) &&
        // Validate chat structure
        request.resource.data.keys().hasAll(['members', 'createdAt', 'updatedAt', 'has_messages', 'text', 'unread']);

      // Allow read if user is member or admin
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        isAdmin()
      );

      // Allow update if user is member or admin
      allow update: if request.auth != null && (
        isChatMember() ||
        isAdmin()
      );

      // Messages subcollection rule
      match /Messages/{messageId} {
        function isMessageParticipant() {
          return request.auth.uid == resource.data.sender_uid ||
                 request.auth.uid == resource.data.recipient_uid;
        }

        // Allow create if user is chat member or admin
        allow create: if request.auth != null && (
          request.auth.uid == request.resource.data.sender_uid ||
          isAdmin()
        );

        // Allow read if user is message participant or admin
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/UserMessages/$(chatId)).data.members.hasAny([request.auth.uid]) ||
          isAdmin()
        );

        // Allow update/delete if user is message participant or admin
        allow update, delete: if request.auth != null && (
          isMessageParticipant() ||
          isAdmin()
        );
      }
    }

    // Users collection rules (unchanged)
    match /users/{userId} {
      allow read: if request.auth != null;
      
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid == 'Y4P4ECBLLWRbk7VZUqkpqqixE7H2'
      );
    }
     match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
  }
  }
}